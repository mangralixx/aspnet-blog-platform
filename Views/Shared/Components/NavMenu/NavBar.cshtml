@using WebApplication.Entities
@model IEnumerable<Navigate>

<nav id="navmenu" class="navmenu">
    <ul>

        @foreach (var navElement in Model.Where(x => x.ParentId == null))
        {
            @if (navElement.Childs == null || navElement.Childs.Count == 0)
            {
                @* Звичайний пункт меню *@
                <li><a href="@navElement.Href">@navElement.Title</a></li>
            }
            else
            {
                <li class="dropdown">
                    <a href="@navElement.Href">
                        <span>@navElement.Title</span>
                        <i class="bi bi-chevron-down toggle-dropdown"></i>
                    </a>
                    <ul>
                        @foreach (var oneChild in navElement.Childs)
                        {
                
                            <li><a href="@oneChild.Href">@oneChild.Title</a></li>
                        }
                    </ul>
                </li>
            }
        }
    </ul>
    <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
</nav>