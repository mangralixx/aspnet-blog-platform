<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - ZenBlog</title>

    <link href="~/img/favicon.png" rel="icon">
    <link href="~/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">

    <link href="~/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <link href="~/css/main.css" rel="stylesheet">
</head>

<body class="index-page">

    <header id="header" class="header d-flex align-items-center sticky-top">
        <div class="container position-relative d-flex align-items-center justify-content-between">

            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto me-xl-0">
                <h1 class="sitename">ZenBlog</h1>
            </a>

            <nav id="navmenu" class="navmenu">
                <ul class="d-flex align-items-center list-unstyled mb-0">
                    @await Component.InvokeAsync("NavMenu")
                    <li>
                        <a href="/Blog/Index" class="btn-getstarted ms-3" style="background: #f06292; color: white; padding: 8px 20px; border-radius: 4px; text-decoration: none;">Блог</a>
                    </li>
                </ul>
            </nav>

            <div class="header-social-links">
                <a href="#" class="twitter"><i class="bi bi-twitter-x"></i></a>
                <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
                <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
            </div>

        </div>
    </header>

    <main class="main">
        @RenderBody()
    </main>

    <footer id="footer" class="footer dark-background">

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
                        <span class="sitename">ZenBlog</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p>вул. Шевченка, 1</p>
                        <p>Київ, 01001</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>+380 99 123 45 67</span></p>
                        <p><strong>Email:</strong> <span>info@example.com</span></p>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3">
                    @await Component.InvokeAsync("Categories")
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Корисні посилання</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Головна</a></li>
                        <li><a asp-controller="Blog" asp-action="Index">Блог</a></li>
                        <li><a asp-controller="Home" asp-action="About">Про нас</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Контакти</a></li>
                    </ul>
                </div>

            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© @DateTime.Now.Year <span>Copyright</span> <strong class="px-1 sitename">ZenBlog</strong></p>
        </div>

    </footer>

    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
    <div id="preloader"></div>

    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/aos/aos.js"></script>
    <script src="~/vendor/swiper/swiper-bundle.min.js"></script>

    <script src="~/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>